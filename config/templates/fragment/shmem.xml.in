<!--
  共享内存设备（Looking Glass 的数据通道）

  KVMFR（/dev/kvmfr0）而不是普通 /dev/shm：
  KVMFR 能把帧缓冲导出成 DMA-BUF，让宿主 GPU 直接导入（零拷贝）；
  普通共享内存方式客户端还要再拷一遍。

  ⚠ size 必须与 kvmfr 模块的 static_size_mb 完全一致，否则 LGMP 握手失败。
  ⚠ /dev/kvmfr0 必须是字符设备：如果 QEMU 先启动把它创造成普通文件，模块就再也建不出字符设备。
-->
<qemu:commandline>
  <qemu:arg value='-device'/>
  <qemu:arg value='{&apos;driver&apos;:&apos;ivshmem-plain&apos;,&apos;id&apos;:&apos;shmem0&apos;,&apos;memdev&apos;:&apos;looking-glass&apos;}'/>
  <qemu:arg value='-object'/>
  <qemu:arg value='{&apos;qom-type&apos;:&apos;memory-backend-file&apos;,&apos;id&apos;:&apos;looking-glass&apos;,&apos;mem-path&apos;:&apos;/dev/kvmfr0&apos;,&apos;size&apos;:${WB_SHM_SIZE_BYTES},&apos;share&apos;:true}'/>
</qemu:commandline>
