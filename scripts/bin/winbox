#!/usr/bin/env bash
# code-master:title win-box · 唯一入口（L1 dispatcher）
#
# 契约：docs/interfaces/01-winbox-cli.md
#
# 本文件只做三件事，业务逻辑一律不写在这里：
#   1. 解析全局选项（--config / --dry-run / --yes / --quiet / --verbose / --no-color）
#   2. 载入函数库与配置
#   3. 把命令转发给 scripts/bin/<命令>
#
# 转发方式为 exec：命令的退出码原样成为 winbox 的退出码（契约要求）。
set -euo pipefail

WB_SELF=$(basename -- "$0")
WB_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
WB_LIB_DIR="$WB_ROOT/scripts/lib"
export WB_ROOT WB_SELF WB_LIB_DIR

# shellcheck source=../lib/log.sh
source "$WB_LIB_DIR/log.sh"
# shellcheck source=../lib/sys.sh
source "$WB_LIB_DIR/sys.sh"
# shellcheck source=../lib/conf.sh
source "$WB_LIB_DIR/conf.sh"

WB_VERSION=$(cat -- "$WB_ROOT/VERSION" 2>/dev/null || printf 'unknown')

# 已知命令（顺序即 --help 里的展示顺序）。是否"已实现"由 scripts/bin/<cmd> 是否存在决定，
# 这样骨架阶段也不会给出误导性的帮助文本。
WB_COMMANDS=(
  detect conf status evidence
  host-prep vm-create gpu-attach
  lg-prepare lg-shmem reset-hook lg
  rom vm
)

usage() {
  cat >&2 <<EOF
win-box $WB_VERSION — 在 Linux 上用 KVM 跑 Windows 11，并把 AMD 核显直通给它

用法: winbox [全局选项] <命令> [命令参数]

全局选项:
  -c, --config FILE   使用指定配置文件（默认 config/win-box.conf）
  -n, --dry-run       只打印将执行的系统改动，不落盘
  -y, --yes           不交互确认（脚本化用）
  -q, --quiet         只输出错误
  -v, --verbose       回显每条被执行的底层命令
      --no-color      关闭颜色
  -h, --help          本帮助
      --version       版本

命令（★ = 已实现；其余按 docs/interfaces 逐步实现）:
EOF
  local c mark
  for c in "${WB_COMMANDS[@]}"; do
    if [[ -x $WB_ROOT/scripts/bin/$c ]]; then mark='★'; else mark=' '; fi
    printf '  %s %-12s %s\n' "$mark" "$c" "$(wb__cmd_desc "$c")" >&2
  done
  cat >&2 <<EOF

文档:
  REQUIREMENTS.md              需求与范围（含"明确不做"的部分）
  docs/interfaces/             对外契约：命令、函数库、C 工具
  docs/calltrees/              端到端链路（含复位轮回、Looking Glass 全链）

失败语义: 错误行格式为 "✗ <stage>: <原因> → <文档锚点>"
          退出码 0 成功 / 1 执行失败 / 2 用法错误 / 3 前置不满足
                 4 硬件不匹配 / 5 需人工介入 / 6 降级 / 7 故障（后两个仅 status）

注意: 本项目不是通用一键安装器。换机器/换发行版不保证可用——
      遇到硬件差异时它会明确报错并指向文档，而不是静默兜底。
EOF
}

wb__cmd_desc() {
  case $1 in
    detect)     printf '探测硬件与环境，生成配置' ;;
    conf)       printf '查看/修改配置（唯一配置入口）' ;;
    status)     printf '全链路自检（退出码即结论）' ;;
    evidence)   printf '采集取证包（只读）' ;;
    host-prep)  printf '宿主机一次性准备（依赖/vfio/initramfs/内核参数）' ;;
    vm-create)  printf '创建 UEFI+SecureBoot+TPM2 的 Windows 11 虚拟机' ;;
    gpu-attach) printf '把核显挂进虚拟机（ROM + root port + x-vga 模式）' ;;
    lg-prepare) printf 'Looking Glass 宿主侧准备（KVMFR 模块 + 构建客户端）' ;;
    lg-shmem)   printf '把共享内存设备挂进虚拟机' ;;
    reset-hook) printf '安装/移除/测试复位轮回钩子' ;;
    lg)         printf '启动 Looking Glass 客户端' ;;
    rom)        printf 'ROM 工具（info/verify/patch/merge/dump/extract）' ;;
    vm)         printf '虚拟机日常运维（= vmctl）' ;;
    *)          printf '' ;;
  esac
}

# ── 全局选项解析 ──────────────────────────────────────────────────────────
while (( $# )); do
  case $1 in
    -c | --config)
      [[ -n ${2:-} ]] || wb_fail 2 cli "选项 $1 需要参数" "winbox --help"
      WB_CONF_PATH=$2; export WB_CONF_PATH; shift 2 ;;
    -n | --dry-run) WB_DRY_RUN=1; shift ;;
    -y | --yes)     WB_YES=1; shift ;;
    -q | --quiet)   WB_QUIET=1; shift ;;
    -v | --verbose) WB_VERBOSE=1; shift ;;
    --no-color)     WB_NO_COLOR=1; shift ;;
    -h | --help)    usage; exit 0 ;;
    --version)
      printf 'win-box %s\n' "$WB_VERSION"
      exit 0 ;;
    --)             shift; break ;;
    -*)             wb_fail 2 cli "未知选项: $1" "winbox --help" ;;
    *)              break ;;
  esac
done
export WB_DRY_RUN WB_VERBOSE WB_QUIET WB_YES WB_NO_COLOR

cmd=${1:-}
(( $# )) && shift || true
WB_ARGS="$cmd $*"
export WB_ARGS

case $cmd in
  '' | help) usage; exit 0 ;;
  version)
    printf 'win-box %s\n' "$WB_VERSION"
    exit 0 ;;
esac

# 配置在转发前统一载入：命令自身不必关心优先级规则
wb_conf_load

# ── 路由 ──────────────────────────────────────────────────────────────────
if [[ $cmd == vm ]]; then
  if [[ -x $WB_ROOT/scripts/bin/vmctl ]]; then
    exec "$WB_ROOT/scripts/bin/vmctl" "$@"
  fi
  wb_fail 1 vm "命令尚未实现（骨架阶段）" "docs/interfaces/02-vmctl.md"
fi

if [[ -x $WB_ROOT/scripts/bin/$cmd ]]; then
  exec "$WB_ROOT/scripts/bin/$cmd" "$@"
fi

for c in "${WB_COMMANDS[@]}"; do
  if [[ $c == "$cmd" ]]; then
    wb_fail 1 "$cmd" "命令尚未实现（骨架阶段）" "docs/interfaces/01-winbox-cli.md"
  fi
done

wb_fail 2 cli "未知命令: $cmd" "winbox --help"
