#!/usr/bin/env bash
# code-master:title win-box · winbox reset-hook（scripts/bin/reset-hook）
#
# 契约：docs/interfaces/01-winbox-cli.md ／ 链路：docs/calltrees/03-vm-start-and-reset-hook.md
#
# 安装/移除/测试 libvirt 钩子：每次启动 VM 之前，让宿主对核显做一次「真复位」。
#
# 为什么需要：AMD 核显直通有复位 bug。VM 关掉后 GPU 处于脏状态，直接再启动会出现
# 客机里代码 43 或设备起不来；让 amdgpu 短暂接管再解绑会触发内核 MODE2 reset，
# 之后客机驱动就能正常初始化 —— 代价是每次启动多等 20–30 秒。
#
# 钩子文件是**极薄的壳**：source 函数库 → 调 wb_gpu_reset_cycle → exit 0。
# 逻辑放在 scripts/lib/gpu.sh 里，这样：
#   * 人手可以单独调用同一个函数来调试（场景 4）
#   * 改造逻辑不必动 /etc 下的文件
#   * ★ 钩子永远 exit 0：绝不能因为复位失败而阻止 VM 启动
#
# 用法：
#   sudo winbox reset-hook install   # 安装（幂等）
#   sudo winbox reset-hook test      # 手动跑一次并显示日志
#   sudo winbox reset-hook remove    # 卸载
#   winbox reset-hook show           # 查看当前钩子
#
# 测试友好：WB_HOOK_ROOT 可覆盖钩子根目录（默认 /etc/libvirt/hooks），
# 设成非默认值时不要求 root —— 冒烟测试靠它离线验证安装/卸载。
set -euo pipefail

WB_ROOT=${WB_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}
WB_LIB_DIR=${WB_LIB_DIR:-$WB_ROOT/scripts/lib}
# shellcheck source=../lib/log.sh
source "$WB_LIB_DIR/log.sh"
# shellcheck source=../lib/sys.sh
source "$WB_LIB_DIR/sys.sh"
# shellcheck source=../lib/conf.sh
source "$WB_LIB_DIR/conf.sh"

wb_conf_load

HOOK_ROOT=${WB_HOOK_ROOT:-/etc/libvirt/hooks}
VM=$(wb_conf_get_default WB_VM_NAME win11)
HOOK_DIR="$HOOK_ROOT/qemu.d/$VM/prepare/begin"
HOOK="$HOOK_DIR/10-winbox-reset.sh"
LOG=${WB_RESET_LOG:-/var/log/winbox-reset.log}
CONF=$(wb_conf_path)

need_root() {
  # 干跑只打印、不落盘 → 不需要 root（与 host-prep / host-gpu 的策略一致：
  # 让人先看清"会改什么"再决定是否 sudo）
  wb_is_dry_run && return 0
  [[ $HOOK_ROOT != /etc/libvirt/hooks ]] || wb_require_root
  return 0
}

usage() {
  cat >&2 <<'EOF'
用法: winbox reset-hook <install|remove|test|show> [--takeover]

  install            安装 prepare/begin 钩子（幂等；需 root）
  install --takeover 同时停用目录里其它旧钩子（它们会重复执行复位）
  remove             卸载钩子
  test               手动执行一次钩子并显示日志尾部
  show               显示钩子路径、目录里现有的钩子与日志位置
EOF
  exit "${1:-0}"
}

hook_body() {
  cat <<EOF
#!/bin/bash
# 由 winbox reset-hook install 生成 —— 请勿手工编辑。
# 逻辑在 $(printf '%s' "$WB_LIB_DIR")/gpu.sh 的 wb_gpu_reset_cycle 里；
# 改行为请改那里，然后重跑 winbox reset-hook install。
#
# 契约要点（docs/calltrees/03-vm-start-and-reset-hook.md）：
#   * 本钩子永远 exit 0 —— 复位失败也不能阻止 VM 启动
#   * 复位过程写日志到 $LOG
set -u

WB_ROOT='$(printf '%s' "$WB_ROOT")'
WB_LIB_DIR='$(printf '%s' "$WB_LIB_DIR")'
WB_CONF_PATH='$(printf '%s' "$CONF")'
WB_RESET_LOG='$(printf '%s' "$LOG")'

source "\$WB_LIB_DIR/log.sh"
source "\$WB_LIB_DIR/sys.sh"
source "\$WB_LIB_DIR/conf.sh"
source "\$WB_LIB_DIR/pci.sh"
source "\$WB_LIB_DIR/gpu.sh"

wb_conf_load
wb_gpu_reset_cycle
exit 0
EOF
}

case ${1:-} in
  install)
    need_root
    wb_step '1/3' "安装钩子 $HOOK"
    wb_run mkdir -p -- "$HOOK_DIR"

    # 同一个 prepare/begin 目录里如果还有其它复位钩子，它们会与本钩子重复执行
    # （每次启动多做一遍复位；无害但慢且难排查）——告知并提供 --takeover 移开
    other=$(find "$HOOK_DIR" -maxdepth 1 -type f -executable ! -name "$(basename -- "$HOOK")" -printf '%f\n' 2>/dev/null | sort | tr '\n' ' ' || true)
    if [[ -n ${other// /} ]]; then
      if [[ ${2:-} == --takeover || ${1:-} == --takeover ]]; then
        for f in $other; do
          wb_run mv -- "$HOOK_DIR/$f" "$HOOK_DIR/$f.disabled"
          wb_ok "已停用旧钩子: $f → $f.disabled"
        done
      else
        wb_warn "该目录还有其它钩子（会重复复位）: $other"
        wb_hint '要停用它们：sudo winbox reset-hook install --takeover'
      fi
    fi

    tmp=$(mktemp)
    hook_body > "$tmp"
    bash -n "$tmp" || { rm -f -- "$tmp"; wb_fail 1 reset-hook "生成的钩子语法错误" "docs/calltrees/03-vm-start-and-reset-hook.md"; }
    if wb_is_dry_run; then
      wb_log "  [dry-run] 写入钩子内容："
      sed 's/^/      /' "$tmp" >&2
      rm -f -- "$tmp"
    else
      install -m 755 -- "$tmp" "$HOOK"
      rm -f -- "$tmp"
      wb_ok "已安装: $HOOK"
    fi
    wb_step '2/3' '前置检查'
    mode=$(wb_conf_get_default WB_VIDEO_MODE lg)
    wb_log "    显示模式: $mode（复位与模式无关，任何模式都会执行）"
    gpu=$(wb_conf_get_default WB_GPU_BDF '')
    if [[ -z $gpu ]]; then
      wb_warn '未配置 WB_GPU_BDF：钩子会跳过复位（先跑 winbox detect --write）'
    else
      wb_log "    核显: $gpu → 音频: $(wb_conf_get_default WB_AUDIO_BDF '（无）')"
    fi
    wb_step '3/3' '日志位置'
    wb_log "    $LOG"
    wb_log ''
    wb_ok '钩子已就绪：以后 winbox vm start 会自动先做核显真复位（多等 20–30 秒是故意的）'
    wb_hint '现在验证一次: sudo winbox reset-hook test'
    ;;
  remove)
    need_root
    if [[ -e $HOOK ]]; then
      wb_run rm -f -- "$HOOK"
      rmdir -p --ignore-fail-on-non-empty "$HOOK_DIR" 2>/dev/null || true
      wb_ok "已移除: $HOOK"
    else
      wb_ok "本就没有安装（$HOOK 不存在）"
    fi
    ;;
  test)
    [[ -x $HOOK ]] || wb_fail 3 reset-hook "钩子未安装: $HOOK（先 sudo winbox reset-hook install）" \
      "docs/interfaces/01-winbox-cli.md"
    wb_log "== 手动执行钩子（模拟 prepare begin）=="
    "$HOOK" "$VM" || wb_warn "钩子返回非零（正常情况下它总是 exit 0）"
    wb_log ''
    wb_log "== 日志尾部（$LOG）=="
    tail -n 20 "$LOG" 2>/dev/null | sed 's/^/  /' || wb_warn '日志尚未生成'
    ;;
  show)
    wb_log "钩子: $HOOK"
    if [[ -e $HOOK ]]; then
      wb_ok '已安装（winbox 版本）'
      sed 's/^/  /' "$HOOK" >&2
    else
      wb_warn 'winbox 钩子未安装'
    fi
    others=$(find "$HOOK_DIR" -maxdepth 1 -type f -executable -printf '%f\n' 2>/dev/null | sort | tr '\n' ' ' || true)
    [[ -n ${others// /} ]] && wb_log "目录里的钩子: $others"
    wb_log "日志: $LOG"
    ;;
  -h | --help | help | '') usage 0 ;;
  *) wb_fail 2 reset-hook "未知子命令: ${1:-}" "winbox reset-hook --help" ;;
esac
