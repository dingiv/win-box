#!/usr/bin/env bash
# code-master:title win-box · winbox host-gpu（scripts/bin/host-gpu）
#
# 契约：docs/interfaces/01-winbox-cli.md
#
# 宿主核显姿态开关：把核显在「直通姿态」与「宿主姿态」之间切换。
#
#   passthrough  宿主不用核显（黑名单 + vfio ids= + initramfs 清理 + 当前绑到 vfio-pci）
#   host         核显交回宿主（撤掉上述配置 + 当前绑到 amdgpu）
#
# 两个方向都做两件事：**持久化配置**（modprobe.d / initramfs，需重启才完全生效）
# 与**立即生效**（当前会话的绑定）。因此：
#   * 有持久化改动 → 退出码 5（需要重启），与 host-prep 一致
#   * 切到 host 前检查 VM 是否在跑；切到 passthrough 前检查核显是否正被宿主使用
#
# 用法：
#   winbox host-gpu                 # 看当前姿态（= status）
#   sudo winbox host-gpu passthrough [--takeover]
#   sudo winbox host-gpu host        [--takeover]
#   winbox -n host-gpu host          # 干跑：看清会改哪些文件
set -euo pipefail

WB_ROOT=${WB_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}
WB_LIB_DIR=${WB_LIB_DIR:-$WB_ROOT/scripts/lib}
# shellcheck source=../lib/log.sh
source "$WB_LIB_DIR/log.sh"
# shellcheck source=../lib/sys.sh
source "$WB_LIB_DIR/sys.sh"
# shellcheck source=../lib/conf.sh
source "$WB_LIB_DIR/conf.sh"
# shellcheck source=../lib/pci.sh
source "$WB_LIB_DIR/pci.sh"
# shellcheck source=../lib/gpu.sh
source "$WB_LIB_DIR/gpu.sh"
# shellcheck source=../lib/host.sh
source "$WB_LIB_DIR/host.sh"

wb_conf_load

ACTION=${1:-status}
TOKEOVER=''
shift || true
while (( $# )); do
  case $1 in
    --takeover) TOKEOVER=--takeover; shift ;;
    --purge)    ACTION=purge; shift ;;
    -h | --help)
      sed -n '4,20p' "$0" | sed 's/^# \{0,1\}//'
      echo >&2
      echo "用法: winbox host-gpu [status|passthrough|host|purge] [--takeover]" >&2
      echo '  --takeover  处理冲突：注释别人文件里的 ids=/softdep，停用并归档遗留的开机绑定脚本' >&2
      echo '  --purge     删除我们归档过的 unit（*.disabled-by-winbox）及其 ExecStart 脚本' >&2
      echo '退出码: 0 成功 / 1 失败 / 2 用法 / 3 前置不满足 / 5 需要重启' >&2
      exit 0 ;;
    *) wb_fail 2 host-gpu "未知参数: $1" "winbox host-gpu --help" ;;
  esac
done

show_status() {
  local mode desired
  mode=$(wb_host_gpu_detect)
  desired=$(wb_conf_get_default WB_HOST_GPU_MODE '')
  wb_log '== 宿主核显姿态 =='
  while IFS='=' read -r k v; do
    printf '  %-20s %s\n' "$k" "$v"
  done < <(wb_host_gpu_detail)
  # 常见误解：看到 amdgpu 被加载就以为它接管了核显 —— 其实"加载"与"绑定"是两件事
  if [[ $(grep -q '^amdgpu' /proc/modules 2>/dev/null && echo yes || echo no) == yes ]] \
     && [[ $(wb_pci_driver "$(wb_conf_get_default WB_GPU_BDF '')" 2>/dev/null || echo '') != amdgpu ]]; then
    wb_log '  （amdgpu 模块已加载但未绑定任何设备 —— 正常：udev 按 modalias 自动加载它，'
    wb_log '    而设备已被 vfio-pci 在开机早期认领；判据是 driver 与引用数，不是"模块在不在"）'
  fi
  wb_log ''
  case $mode in
    passthrough) wb_ok '当前：直通姿态（宿主不用核显，客机可以直通）' ;;
    host)        wb_ok '当前：宿主姿态（核显归宿主使用）' ;;
    mixed)       wb_warn '当前：**混合**（黑名单与 ids= 只存在一个）——语义不完整，建议明确切一次' ;;
  esac
  if [[ -n $desired && $desired != "$mode" ]]; then
    wb_warn "与配置里的期望姿态不一致：desired=$desired 实际=$mode"
  fi
  bootunits=$(wb_host_gpu_boot_units)
  if [[ -n $bootunits ]]; then
    printf '%s\n' "$bootunits" | awk -F'|' '{printf "  %-20s %s → %s\n", "boot_script", $1, $3}' >&2
    case $mode in
      host) wb_warn '该脚本会在每次开机把核显绑回 vfio-pci —— host 姿态会被它覆盖' ;;
      *)    wb_log '  （该脚本与当前直通姿态一致；但它是"别人的机制"，本工具不依赖它）' ;;
    esac
  fi
  if [[ $(wb_pci_driver "$(wb_conf_get_default WB_GPU_BDF '')" 2>/dev/null || echo '') == amdgpu ]] \
     && [[ $mode == passthrough ]]; then
    wb_hint '配置是直通姿态但核显当前归 amdgpu —— 重启后，或 ./winbox vm start（启动前自带复位）才会交回 vfio-pci'
  fi
  return 0
}

case $ACTION in
  status | '') show_status; exit 0 ;;
  purge)
    # 只清理"我们归档过的"遗留：系统自带的服务绝不会被这里碰到
    if ! wb_is_dry_run; then wb_require_root; fi
    wb_log '== 清理我们归档过的遗留 unit =='
    wb_host_gpu_purge_archived_units
    exit 0 ;;
  passthrough | host) ;;
  *) wb_fail 2 host-gpu "未知动作: $ACTION（status|passthrough|host）" "winbox host-gpu --help" ;;
esac

# ── 前置检查（两个方向共同的部分）─────────────────────────────────────────
if ! wb_is_dry_run; then wb_require_root; fi
[[ -n $(wb_conf_get_default WB_GPU_BDF '') ]] || wb_fail 3 host-gpu \
  '未配置 WB_GPU_BDF（先跑 winbox detect --write）' "docs/interfaces/01-winbox-cli.md"

GPU_BDF=$(wb_conf_get_default WB_GPU_BDF '')
AUD_BDF=$(wb_conf_get_default WB_AUDIO_BDF '')

if [[ $ACTION == passthrough ]]; then
  # ── 切到直通姿态：期望 GPU/音频 都归 vfio-pci ───────────────────────────
  wb_step '1/3' '占用检查'
  if wb_host_gpu_vm_running; then
    wb_fail 3 host-gpu \
      '虚拟机正在运行：先把客机 ACPI 关机（winbox vm shutdown），否则等于把 GPU 从 QEMU 手里抽走' \
      "docs/interfaces/02-vmctl.md"
  fi
  if [[ $(wb_pci_driver "$GPU_BDF") == vfio-pci ]]; then
    wb_ok '核显已在 vfio-pci 上'
  elif wb_host_gpu_amdgpu_in_use; then
    wb_warn '核显当前正被宿主使用（有已连接的显示输出，或 /dev/dri 被进程打开）'
    wb_warn '切成直通后核显会从宿主手里拿走：宿主上的显示/编码会中断'
    wb_confirm '确认切到直通姿态?' || wb_fail 5 host-gpu '用户取消（核显正被宿主使用）' \
      "docs/interfaces/01-winbox-cli.md"
  else
    wb_ok '核显未被宿主占用'
  fi

  wb_step '2/3' '持久化配置（modprobe.d + initramfs）'
  changed=0
  rc=0
  wb_host_gpu_config_passthrough || rc=$?
  case $rc in
    0) changed=1 ;;
    1) ;;
    *) wb_fail "$rc" host-gpu '写入持久化配置失败' "docs/interfaces/01-winbox-cli.md" ;;
  esac

  wb_step '3/3' '立即生效（当前会话绑定）'
  live_ok=1
  if wb_is_dry_run; then
    wb_log "  [dry-run] 将把 $GPU_BDF（与音频功能）绑到 vfio-pci，并给运行中的 vfio-pci 注册动态 ID"
  else
    wb_host_gpu_live_passthrough || live_ok=0
  fi
  wb_conf_set WB_HOST_GPU_MODE passthrough
  target='核显与音频功能都绑在 vfio-pci（宿主不占用）'
else
  # ── 切到宿主姿态：期望 GPU→amdgpu、音频→snd_hda_intel ──────────────────
  wb_step '1/3' '占用检查'
  if wb_host_gpu_vm_running; then
    wb_fail 3 host-gpu \
      '虚拟机正在运行：先把客机 ACPI 关机（winbox vm shutdown），否则等于把 GPU 从 QEMU 手里抽走' \
      "docs/interfaces/02-vmctl.md"
  fi
  wb_ok '虚拟机未运行'
  [[ -n $TOKEOVER ]] && wb_ok '按 --takeover 处理冲突（含遗留的开机绑定脚本）'

  wb_step '2/3' '持久化配置（撤掉直通配置）'
  changed=0
  rc=0
  wb_host_gpu_config_host "$TOKEOVER" || rc=$?
  case $rc in
    0) changed=1 ;;
    1) ;;
    *) wb_fail "$rc" host-gpu '撤销持久化配置失败' "docs/interfaces/01-winbox-cli.md" ;;
  esac

  wb_step '3/3' '立即生效（交回宿主）'
  live_ok=1
  if wb_is_dry_run; then
    wb_log '  [dry-run] 将清掉 vfio-pci 的动态 ID 与 driver_override → modprobe amdgpu/snd_hda_intel → 显式绑定'
  else
    wb_host_gpu_live_host || live_ok=0
  fi
  wb_conf_set WB_HOST_GPU_MODE host
  target='核显归宿主使用：GPU → amdgpu，音频 → snd_hda_intel'
fi

echo >&2
wb_log '== 结果 =='
wb_log "  目标状态: $ACTION（$target）"
wb_log "  持久化  : $(wb_host_gpu_detect)   期望: $ACTION"
wb_log "  当前驱动: GPU=$(wb_pci_driver "$GPU_BDF")  音频=$( [[ -n $AUD_BDF ]] && wb_pci_driver "$AUD_BDF" || echo '（无）')"
if wb_is_dry_run; then
  # 干跑没有真正切驱动：这里不能声称"已生效"（踩过——干跑会谎报成功）
  wb_log ''
  wb_log '（--dry-run：以上改动均未落盘，驱动也没有真正切换）'
  exit 0
fi
if (( live_ok )); then
  wb_ok '目标状态已生效（当前会话）；下次开机同样如此（持久化配置已就位）'
  (( changed )) && wb_hint '持久化配置有改动，但当前会话也已切好——不需要为此重启'
  exit 0
fi
wb_warn '目标状态**未达成**（当前会话没切过去）'
wb_hint '先看: winbox host-gpu status（会列出是否还有开机脚本/其它文件在抢核显）'
wb_hint '还存在开机绑定脚本时: sudo winbox host-gpu host --takeover 会停用并归档它'
wb_hint '最后手段: 重启宿主（持久化配置已就位，开机后会落在目标姿态）'
wb_fail 5 host-gpu "未达成目标状态：$target" "docs/interfaces/01-winbox-cli.md"
